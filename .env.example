# Copy this file to `.env` and fill in real values.

# Local development database (managed via `npm run db:start` using embedded-postgres)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/mcqure"

# Secret used to sign session JWTs. Generate a strong value for production.
AUTH_SECRET="replace-with-a-long-random-string"

# AI provider keys (optional). Leave as-is or unset until you have real keys —
# the app runs fine without them and reports AI features as not configured.
GEMINI_API_KEY=your_actual_key
TAVILY_API_KEY=your_actual_key
OPENROUTER_API_KEY=your_actual_key

# Copy this file to `.env` and fill in real values.

# PostgreSQL connection used by Prisma.
# Local development (embedded-postgres on port 5433):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/mcqure"
# Production (e.g. Neon serverless). DIRECT_URL should point at the same
# database without the pgbouncer-style pooling, for migrations:
# DATABASE_URL="postgresql://user:***@host.neon.tech/db?sslmode=require"
# DIRECT_URL="postgresql://user:***@host.neon.tech/db?sslmode=require"

# Secret used to sign session JWTs. Generate a strong value for production.
AUTH_SECRET="replace-with-a-long-random-string"

# AI provider keys (optional). Leave as-is or unset until you have real keys —
# the app runs fine without them and reports AI features as not configured.
GEMINI_API_KEY=your_actual_key
TAVILY_API_KEY=your_actual_key
OPENROUTER_API_KEY=your_actual_key

# ── Payments (optional) ──────────────────────────────────────────────────────
# Without keys the pricing page shows the built-in "test checkout" simulator
# (provider = MANUAL, no real charge). Add keys below to enable live payments.
#
# APP_ENV selects the gateway mode used app-wide:
#   production → LIVE payments only; sandbox/test keys are refused and the
#                simulated test checkout is disabled (403).
#   uat / dev  → test mode by default (simulated checkout shown).
# PAYMENT_MODE can override the default to "live" in non-production (e.g. local
# testing against real keys) but can NEVER downgrade production.
APP_ENV=development
PAYMENT_MODE=test
#
# Razorpay: https://dashboard.razorpay.com/app/keys
# Test keys start with "rzp_test_", live keys with "rzp_live_".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Stripe: https://dashboard.stripe.com/test/apikeys
# Test keys start with "sk_test_", live keys with "sk_live_".
# STRIPE_WEBHOOK_SECRET comes from the Stripe CLI (`stripe listen`) or dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
#
# Public base URL used in Stripe success/cancel redirects (optional; defaults
# to http://localhost:3000 in dev).
NEXT_PUBLIC_APP_URL=

# ── Support / inquiry email (optional) ───────────────────────────────────────
# Recipient for the "Contact admin / Raise an inquiry" form on the pricing
# page. If unset, SUPPORT_EMAIL is used. When neither is set the inquiry is
# still saved to the database but no email is sent.
ADMIN_EMAIL=
SUPPORT_EMAIL=
#
# SMTP server used to deliver those emails (nodemailer). Only needed if you
# want emails sent; SMTP_PORT 465 enables TLS implicitly (secure mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MCQure <no-reply@example.com>
